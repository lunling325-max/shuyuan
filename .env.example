# 复制为 .env 后填入自己的值。.env 已在 .gitignore 里，不会进仓库。
# 这里只放占位符：真实密钥只写进本机 .env，绝不要写进 Dockerfile 或镜像。

# 必填：生成、检索词扩展、翻译都靠它。没有它时服务仍能启动，
# 依赖模型的接口会返回 200 + degraded（断网演示兜底）。
DEEPSEEK_API_KEY=

# 可选：DeepSeek API 地址，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat

# 可选：流式响应的读超时（秒），默认 60。
# 只约束两次 token 之间的最长等待，避免半死连接永久占住线程。
LLM_STREAM_TIMEOUT=60

# 可选：PDF 落盘目录。本地不填时默认 <仓库根>/data/papers；
# 容器里 Dockerfile 已设成 /app/data/papers，通常不需要改。
PAPER_STORE_DIR=

# 仅 Docker 部署使用，默认 8017：应用代码本身不读它，
# 由 Dockerfile 的 CMD 和 docker-compose.yml 展开成 uvicorn --port。
PORT=8017
